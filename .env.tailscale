# ============================================
# Tailscale IP Configuration
# ============================================
# Điền Tailscale IP của máy này (lấy bằng: tailscale ip -4)
THIS_MACHINE_IP=100.x.x.x

# Điền Tailscale IP của máy chạy Spark Master
MASTER_TAILSCALE_IP=100.x.x.x

# ============================================
# Worker Configuration (nếu máy này chạy worker)
# ============================================
# ID của worker này (nếu 1 máy chạy nhiều workers: worker-1, worker-2, ...)
WORKER_ID=1

# Resources cho worker này
SPARK_WORKER_CORES=4
SPARK_WORKER_MEMORY=8g

# ============================================
# Spark Configuration
# ============================================
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEBUI_PORT=8080

# ============================================
# Kafka Configuration
# ============================================
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
